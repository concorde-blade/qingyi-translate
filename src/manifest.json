{
  "manifest_version": 3,
  "name": "清译 · 上下文双语翻译",
  "version": "0.1.2",
  "description": "网页双语与划词翻译，直连自选 AI 服务，支持上下文、术语表、限流重试。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "清译",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-translation": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "翻译网页 / 恢复原文"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
